generator client {
  provider      = "prisma-client-js"
  // 含 windows：在 macOS 上打 Windows 离线包时 Prisma 引擎齐全
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  WEBMASTER
  ADMIN
}

enum DailyReportStatus {
  approved
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         Role
  createdAt    DateTime      @default(now())
  dailyReports DailyReport[] @relation("CreatedReports")
}

model Shift {
  id           String        @id @default(cuid())
  name         String
  sortOrder    Int
  active       Boolean       @default(true)
  dailyReports DailyReport[]
}

model ResponsiblePerson {
  id     String @id @default(cuid())
  name   String
  active Boolean @default(true)
}

/// 单行全局设置（收银底钱等）
model AppSettings {
  id                  String  @id @default("default")
  registerFloatAmount Int     @default(0)
  setupCompleted      Boolean @default(false)
}

model DailyReport {
  id                         String @id @default(cuid())
  reportDate                 String
  shiftId                    String
  shift                      Shift  @relation(fields: [shiftId], references: [id])
  shiftNameSnapshot          String

  responsiblePersonId        String
  responsiblePersonSnapshot  String

  startMinuteOfDay           Int
  endMinuteOfDay             Int
  timeRangeLabelSnapshot     String

  previousImosBalanceYen     Int @default(0)
  currentImosBalanceYen      Int @default(0)
  imosSalesYen               Int @default(0)

  newageYen                  Int @default(0)
  /// お手元残高（底銭込）円 — ユーザー入力そのまま
  cashTotalYen               Int @default(0)
  expenseYen                 Int @default(0)
  expenseReason              String?

  /// 网管餐费现金：包含在钱箱现金中，但不属于实际销售
  staffMealCashYen           Int @default(0)
  /// 网管餐费支付宝：独立保存，不进入现金入金或实际销售
  staffMealAlipayYen         Int @default(0)

  /// 実際売上 = Newage売上 + お手元残高 - 底銭 - 网管餐费现金
  totalSalesYen              Int @default(0)
  cashDepositYen             Int @default(0)
  deviationYen               Int @default(0)

  status                     DailyReportStatus @default(approved)

  createdByUserId            String
  createdBy                  User   @relation("CreatedReports", fields: [createdByUserId], references: [id])
  updatedAt                  DateTime @updatedAt

  @@unique([reportDate, shiftId])
  @@index([reportDate])
  @@index([createdByUserId, reportDate])
}
